---
import { cn } from '@/lib/utils'

interface Props {
  variant?: 'primary' | 'secondary'
  class?: string
  [key: string]: any
}

const { variant = 'primary', class: className = '', ...rest } = Astro.props as Props

const variants =
  variant === 'primary'
    ? 'text-gray-900 bg-white hover:bg-gray-100 border border-white/20'
    : 'text-white bg-white/5 hover:bg-white/10 border border-white/10'
---

<button
  class={cn(
    'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all outline-none cursor-pointer h-9 px-4 has-[>svg]:px-3 py-2',
    variants,
    className
  )}
  {...rest}
>
  <slot />
</button>
